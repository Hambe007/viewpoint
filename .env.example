# Copy this file to .env and fill it in.  NEVER commit .env.

# ---- Security -------------------------------------------------------------
# Long random secret. TradingView must send it: https://your-url/webhook?token=THIS
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(24))"
WEBHOOK_TOKEN=change-me-to-a-long-random-string
# Optional: only accept requests from TradingView's servers. Use "tradingview"
# or a comma-separated list of IPs. Leave empty while testing by hand.
IP_ALLOWLIST=

# ---- Mode -----------------------------------------------------------------
BROKER=mt5            # mt5 = real terminal, paper = fake broker for testing
DRY_RUN=true          # true = log what WOULD be traded, send nothing. Set false to go live.
TRADING_ENABLED=true

# ---- Exness MT5 login (leave blank to use the account already logged in) ---
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=Exness-MT5Trial      # e.g. Exness-MT5Trial6 (demo) / Exness-MT5Real8 (live) - see MT5 login window
MT5_PATH=                       # e.g. C:\Program Files\MetaTrader 5 EXNESS\terminal64.exe

# ---- Symbols ----------------------------------------------------------------
# TradingView names allowed to trade
ALLOWED_SYMBOLS=XAUUSD,EURUSD,GBPUSD
# TradingView name -> Exness name. Standard accounts use an "m" suffix (XAUUSDm);
# Raw Spread / Zero / Pro accounts usually use the plain name. Check MT5 Market Watch.
SYMBOL_MAP=XAUUSD:XAUUSDm,EURUSD:EURUSDm,GBPUSD:GBPUSDm

# ---- Risk -------------------------------------------------------------------
RISK_PERCENT=0.5              # % of equity lost if the stop loss is hit
FIXED_LOT=                    # e.g. 0.01 - overrides RISK_PERCENT when set
MAX_LOT=1.0                   # never more than this in total per signal
TP_SPLIT=0.5,0.3,0.2          # share of the position closed at TP1, TP2, TP3
MAX_DAILY_LOSS_PERCENT=3      # stop opening trades after losing this much today
MAX_OPEN_POSITIONS=6
CLOSE_ON_OPPOSITE=true        # a sell signal closes open buys (and vice versa)
MAX_SPREAD_PCT_OF_SL=0.15     # skip if spread > 15% of the stop distance
MAX_ENTRY_DRIFT_PCT_OF_SL=0.35  # skip if price ran > 35% of the stop distance away from the alert entry

# ---- Trade management --------------------------------------------------------
BREAKEVEN_AFTER_TP1=true      # when TP1 is hit, move the SL of TP2/TP3 to the entry price
BREAKEVEN_BUFFER_POINTS=0     # lock in a little profit, e.g. 200 = $0.20 on gold (Exness 3-digit)
MONITOR_SECONDS=5             # how often open trades are checked

# ---- Telegram alerts (optional) ----------------------------------------------
# 1. In Telegram, message @BotFather -> /newbot -> copy the token here.
# 2. Send your new bot any message, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id": ...}.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_REJECTED=true          # also message you when a signal is skipped by a safety check

# ---- Misc -------------------------------------------------------------------
MAGIC=20261012
DEVIATION_POINTS=50
DEDUP_SECONDS=60
HOST=127.0.0.1
PORT=8000
JOURNAL_PATH=journal.db
